<resources>
    <style name="Theme.Lgram" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">#5B8DEF</item>
        <item name="colorPrimaryDark">#17212B</item>
        <item name="colorAccent">#5B8DEF</item>
        <item name="android:windowBackground">#0E1621</item>
        <item name="materialButtonStyle">@style/LgramButton</item>
    </style>

    <!-- Один стиль для ВСІХ кнопок застосунку (MaterialButton, бо тема —
         MaterialComponents) — заокруглені, акцентного кольору, без КАПСУ,
         без потреби правити кожен layout окремо. -->
    <style name="LgramButton" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/button_accent</item>
        <item name="cornerRadius">22dp</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="android:minHeight">44dp</item>
        <item name="elevation">0dp</item>
    </style>
</resources>
